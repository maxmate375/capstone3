# Variables used by uber-taxi-agentic-etl (all have defaults in src/config.py).
# Secrets are NOT set here: they live in Azure Key Vault and are read through the
# Databricks secret scope (sp-client-id, sp-tenant-id, sp-client-secret,
# foundry-endpoint, foundry-deployment, and foundry-api-key if key auth is used).

STORAGE_ACCOUNT=stuberetlabhi01
SECRET_SCOPE=uber-etl-scope
CATALOG=dbw_uber_etl
SCHEMA=uber_etl
EXPECTED_START_DATE=2024-01-01
EXPECTED_END_DATE=2024-12-30
JOB_NAME=uber-taxi-etl
JOB_TIMEOUT_SECONDS=1800

# Microsoft Foundry (optional here: otherwise read from the secret scope)
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_VERSION=2024-10-21
FOUNDRY_AUTH_MODE=entra
